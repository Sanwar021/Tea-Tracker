# Neon Postgres Connection URL (from Neon Dashboard or Vercel Marketplace)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require

# 4-Digit PIN for Office Boy Counter Screen
COUNTER_PIN=CHANGE_TO_A_PRIVATE_4_DIGIT_PIN

# Password for Management Admin Panel
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_ADMIN_PASSWORD

# JWT & Cookie Session Secret Key (at least 32 characters)
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
